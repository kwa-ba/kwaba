[importlinter]
root_packages =
    apps
    shared

[importlinter:contract:modules-metier]
name = Les modules métier ne dépendent pas les uns des autres
type = independence
modules =
    apps.agenda
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.finance
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.mobilite
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
ignore_imports =
    apps.** -> apps.*.api

[importlinter:contract:noyau-partage]
name = Le noyau partagé (shared : securite, notifications, export, activity, language) ne dépend d'aucun module métier
type = forbidden
source_modules =
    shared
forbidden_modules =
    apps.agenda
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.finance
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.mobilite
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages

[importlinter:contract:emails]
name = Les emails passent par shared.notifications.api
type = forbidden
source_modules =
    apps.agenda
    apps.avis
    apps.backoffice
    apps.concierge
    apps.contrats
    apps.documents
    apps.experiences
    apps.favoris
    apps.finance
    apps.give
    apps.hebergements
    apps.locations
    apps.messaging
    apps.mobilite
    apps.paiements
    apps.reservations
    apps.terrain
    apps.transferts
    apps.users
    apps.verifications
    apps.voyages
forbidden_modules =
    shared.notifications.application
    shared.notifications.infrastructure
    shared.notifications.management
allow_indirect_imports = True

[importlinter:contract:finance-couches]
name = Module finance : le domaine et l'application ne dépendent pas de l'infrastructure (ADR-024)
type = layers
containers =
    apps.finance
layers =
    infrastructure
    application
    domain
